# Neon PostgreSQL (проєкт "roommate"): connection string з Neon Console
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Довільний довгий випадковий рядок (openssl rand -hex 32)
PAYLOAD_SECRET=
# Публічна адреса CMS (для production), локально можна не задавати
CMS_URL=http://localhost:3000
# Дозволені origin-и frontend через кому (localhost:5173 дозволений завжди)
FRONTEND_URL=http://localhost:5173
# Необов'язково: створити адміна під час seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
